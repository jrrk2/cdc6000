   CH : CHAR; AVAL : ALFA; IVAL : INTEGER; A : CWORD;
   NO,CL : SHRTINT;
   (*CH IS OUTPUT BY NEXTCH AND USED BY INSYMBOL.
      AVAL/IVAL, NO, CL  ARE OUTPUT BY INSYMBOL*)

   TCT,TMAX,B60PL,KK : SHRTINT ;
   PT : CTP; IT,IT1 : INTEGER;
