         UNTIL IT1 = 0 ;
         UNDLAB[IT2].SUCC := CHNIX ;
         CHNIX := INX ; IC := IC + 1
      END
   END ;
   FOR IT := 1 TO CA DO
   BEGIN PASCLGO^ := CODE[IT] ; PUT(PASCLGO) END ;
   IF PRCODE THEN
   BEGIN
      IC := IC - LCX ; CA := CA - LCX ; PRTCOMP ;
      FOR IT := 1 TO LCX DO
      BEGIN
         CA := CA+1 ; WRITE(' ':2,IC:6 OCT,' ',CODE[CA]:20 OCT,EOL) ;
         IC := IC + 1
      END ;
      IF NOT EOLFLAG THEN
      WRITE(' ':CHCNT+8) ;
   END
END (* WRITOUT *) ;

